# Copy to .env; never put these credentials in NEXT_PUBLIC_* variables.
TIME_ZONE=Asia/Karachi
DAILY_TIME=06:00
# Quran.com: Fateh Muhammad Jalandhri (Fatah Muhammad Jalandhari), Urdu.
TRANSLATION_IDS=234
TRANSLATION_AUDIO=urdu
RECITER_ID=7
QURAN_PROXY_URL=http://127.0.0.1:3001/api/qdc
TARGET_SECONDS=90
MAX_SECONDS=180
# Fresh Pixabay search each day; metadata screening, with generated fallback.
# Other modes: mixed (reviewed library), approved, generated.
BACKGROUND_MODE=daily
BACKGROUND_PROVIDER=pixabay
PIXABAY_API_KEY=
DISCORD_WEBHOOK_URL=
# Alternative: a real Discord bot and your user ID (never a user-account token).
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=
# Leave headroom below Discord's default 20 MiB per-file limit.
DISCORD_MAX_MIB=19
# Optional Qwen selector. Use the API endpoint and model offered in your region.
# With no Qwen configuration, selection rotates deterministically through the catalogue.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash
PEXELS_API_KEY=
RENDER_CONCURRENCY=2
CHROME_PATH=/opt/google/chrome/chrome

# Optional sampled background inspection; cloud package/AWS credentials required.
BACKGROUND_INSPECTION=off
